{
  "name": "world-of-myrdae",
  "productName": "World of Myrdae",
  "version": "1.1.0",
  "description": "Interactive fantasy world map editor and viewer for the World of Myrdae.",
  "author": "World of Myrdae",
  "scripts": {
    "start": "node server.js",
    "db:counts": "node scripts/world-db-tools.js counts",
    "db:validate": "node scripts/world-db-tools.js validate",
    "db:integrity": "node scripts/world-db-tools.js integrity",
    "db:backup": "node scripts/world-db-tools.js backup",
    "db:migrate:v2": "node scripts/migrate-world-db-v2.js up",
    "db:migrate:v2:down": "node scripts/migrate-world-db-v2.js down",
    "test": "node --test \"test/**/*.test.js\"",
    "share:map-editor": "powershell -ExecutionPolicy Bypass -File scripts/start-map-editor-server.ps1",
    "push": "./push-git.sh"
  },
  "dependencies": {
    "sharp": "^0.34.5"
  }
}
