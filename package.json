{
  "name": "world-of-myrdae",
  "productName": "World of Myrdae",
  "version": "1.1.0",
  "description": "Interactive fantasy world map editor and viewer for the World of Myrdae.",
  "author": "World of Myrdae",
  "main": "electron/main.js",
  "scripts": {
    "start": "node server.js",
    "desktop:dev": "electron .",
    "desktop:pack": "electron-builder --dir",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win msi",
    "dist:mac": "electron-builder --mac dmg",
    "push": "./push-git.sh"
  },
  "build": {
    "appId": "com.worldofmyrdae.editor",
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "asar": true,
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**/*",
      "css/**/*",
      "fonts/**/*",
      "images/**/*",
      "js/**/*",
      "*.html",
      "server.js",
      "package.json",
      "!backups/**",
      "!dist/**",
      "!out/**"
    ],
    "win": {
      "icon": "electron/icon.ico",
      "signAndEditExecutable": false,
      "verifyUpdateCodeSignature": false,
      "target": [
        {
          "target": "msi",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "mac": {
      "category": "public.app-category.games",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    }
  },
  "devDependencies": {
    "electron": "^35.1.4",
    "electron-builder": "^24.13.3",
    "png-to-ico": "^3.0.1"
  }
}
